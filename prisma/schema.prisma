// Farm Manager — one app: Systems, Schedules, and Tasks.
// Multi-tenant: every domain entity is scoped to a Workspace.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
  captures    CaptureBatch[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  projects    Project[]
  tasks       Task[]
  captures    CaptureBatch[]
  corrections AiCorrection[]
  systems     System[]
}

/// User corrections used as few-shot training for future capture parses.
model AiCorrection {
  id          String   @id @default(cuid())
  workspaceId String
  /// What was wrong, e.g. board
  field       String
  taskTitle   String
  beforeValue String?
  afterValue  String
  /// Optional free-text hint from the user
  note        String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, field])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("OWNER") // OWNER | ADMIN | MEMBER
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  status      String   @default("ACTIVE") // ACTIVE | DONE | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
}

/// A house or property system (tractor, furnace, well).
model System {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  category    String   @default("Other")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  components Component[]

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@index([workspaceId, name])
}

/// A piece of equipment that belongs to a system.
model Component {
  id                    String    @id @default(cuid())
  workspaceId           String
  systemId              String
  name                  String
  location              String    @default("")
  modelNumber           String    @default("")
  productNumber         String    @default("")
  serialNumber          String    @default("")
  manufacturer          String    @default("")
  warrantyInfo          String    @default("")
  userManual            String    @default("")
  vendorName            String    @default("")
  vendorContact         String    @default("")
  serviceCompanyName    String    @default("")
  serviceCompanyContact String    @default("")
  purchaseDate          DateTime?
  purchaseCost          Float?
  replacementCost       Float?
  notes                 String    @default("")
  sortOrder             Int       @default(0)

  system    System                @relation(fields: [systemId], references: [id], onDelete: Cascade)
  schedules MaintenanceSchedule[]
  tasks     Task[]

  @@index([workspaceId])
  @@index([systemId])
}

/// Recurrence owner for a farm chore. The open chore itself is a Task.
model MaintenanceSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  /// e.g. "30d", "90d", "6mo", "1y"
  frequency    String?
  intervalDays Int?
  isRecurring  Boolean   @default(true)

  nextDueDate     DateTime
  lastCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([workspaceId])
  @@index([componentId])
  @@index([nextDueDate])
}

/// Tasks cover one-time work and the single open chore for a schedule.
model Task {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  parentId    String? // subtask parent

  title String
  notes String?

  /// ONE_TIME | RECURRING_TEMPLATE | OCCURRENCE
  /// New rows are always ONE_TIME. Schedule cadence lives on MaintenanceSchedule.
  kind String @default("ONE_TIME")

  /// ACTIVE | DONE | CANCELLED | SNOOZED | INBOX
  /// PROPOSED is retired: every open task is on the board.
  status String @default("ACTIVE")

  /// User-facing kanban lane: ICEBOX | BACKLOG | CURRENT
  board String @default("BACKLOG")

  /// Why capture picked this lane (shown on the card and in edit).
  boardReason String?

  /// Legacy dual-write sort field (1=Current … 5=Icebox). Prefer `board` in UI.
  priority Int?

  urgencyScore Float?
  impactScore  Float?

  dueAt           DateTime?
  scheduledFor    DateTime?
  completedAt     DateTime?
  snoozedUntil    DateTime?
  estimateMinutes Int?

  /// Legacy JSON recurrence. Farm cadence is MaintenanceSchedule.intervalDays.
  recurrenceRule String?

  nextOccurrenceAt DateTime?

  /// JSON for multi-slot days (legacy; not rendered).
  checkIns String?

  aiRationale     String?
  sourceCaptureId String?

  /// External integration provenance kept one release for traceability.
  externalSource String?
  /// Stable id from a source system (e.g. "bf-task:cuid")
  externalId     String?

  /// Set when this task is the open (or historical) chore for a schedule.
  scheduleId  String?
  componentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    Task?                @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Task[]               @relation("TaskTree")
  capture   CaptureBatch?        @relation(fields: [sourceCaptureId], references: [id], onDelete: SetNull)
  schedule  MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  component Component?           @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, externalSource, externalId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, kind])
  @@index([workspaceId, board])
  @@index([workspaceId, externalSource])
  @@index([scheduleId])
  @@index([componentId])
}

model CaptureBatch {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  rawText     String
  /// ACCEPTED | UNDONE
  status      String   @default("ACCEPTED")
  /// JSON array of parsed capture items
  proposals   String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
}
