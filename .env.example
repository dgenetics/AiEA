# Local SQLite
DATABASE_URL="file:./dev.db"

# Production durable DB (Vercel Marketplace → Turso free Starter)
# Set automatically when you connect Turso; pull with: vercel env pull
# TURSO_DATABASE_URL="libsql://..."
# TURSO_AUTH_TOKEN="..."

# ── SpaceXAI / xAI ──────────────────────────────────────────────
# 1. Create a key: https://console.x.ai/team/default/api-keys
# 2. Paste it below (never commit .env)
# 3. Restart: npm run dev
XAI_API_KEY=""

# Optional overrides
# XAI_MODEL="grok-4.3"
# XAI_BASE_URL="https://api.x.ai/v1"

# Calendar + AI "today" — default America/New_York (Eastern)
AIEA_TIMEZONE="America/New_York"

# Session signing secret (change in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: cron/job secret for reminder processor
CRON_SECRET="change-me-too"

# ── BF Maintenance integration (server-side only) ───────────────
# Production BF app URL (no trailing slash)
BF_MAINTENANCE_URL="https://bf-maintenance.vercel.app"
# Optional public URL for links/display only
# NEXT_PUBLIC_BF_MAINTENANCE_URL="https://bf-maintenance.vercel.app"
# Shared secret — must match BF_INTEGRATION_SECRET on BF Maintenance
BF_INTEGRATION_SECRET="change-me-long-random-integration-secret"
# Cron auto-pull uses CRON_SECRET (Authorization: Bearer …) on
# GET/POST /api/cron/bf-maintenance-pull — enable per workspace in Account
