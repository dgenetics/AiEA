# Local SQLite
DATABASE_URL="file:./dev.db"

# Production durable DB (Vercel Marketplace → Turso free Starter)
# Set automatically when you connect Turso; pull with: vercel env pull
# TURSO_DATABASE_URL="libsql://..."
# TURSO_AUTH_TOKEN="..."

# ── SpaceXAI / xAI ──────────────────────────────────────────────
# 1. Create a key: https://console.x.ai/team/default/api-keys
# 2. Paste it below (never commit .env)
# 3. Restart: npm run dev
XAI_API_KEY=""

# Optional overrides
# XAI_MODEL="grok-4.3"
# XAI_BASE_URL="https://api.x.ai/v1"

# ── Component label scan (vision + web search) ─────────────────
# Separate from XAI_API_KEY. Without this key, Scan Component still
# reads barcodes and QR codes and shows only what it decoded.
# 1. Create a key: https://console.x.ai/team/default/api-keys
# 2. Paste it here (never commit .env)
# grok-4.3 reads the nameplate first, reasoning off, with no web search.
# A second request (grok-4.7) looks up the manual and any interval it states.
COMPONENT_SCAN_API_KEY=""
# COMPONENT_SCAN_LABEL_MODEL="grok-4.3"
# COMPONENT_SCAN_MODEL="grok-4.7"
# COMPONENT_SCAN_BASE_URL="https://api.x.ai/v1"

# Calendar + AI "today" — default America/New_York (Eastern)
AIEA_TIMEZONE="America/New_York"

# Session signing secret (change in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Cron secret for GET/POST /api/cron/materialize-schedules
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-too"

# Optional one-time import of an existing bf-maintenance database.
# Rows are copied into the oldest workspace. Re-runs skip rows already imported.
# BF_SOURCE_DATABASE_URL="file:../bf-maintenance/prisma/dev.db"
# BF_SOURCE_AUTH_TOKEN=""
