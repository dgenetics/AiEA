{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/maintenance",
      "destination": "https://bf-maintenance.vercel.app/maintenance"
    },
    {
      "source": "/maintenance/:path*",
      "destination": "https://bf-maintenance.vercel.app/maintenance/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/bf-maintenance-pull",
      "schedule": "0 12 * * *"
    }
  ]
}
